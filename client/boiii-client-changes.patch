+      game::server_running() || Demo_IsPlaying() || Demo_IsRecording() ||
+      !game::com::Com_IsInGame() || Com_IsRunningUILevel()) {
+    auto_seen_snapshot = -1;
+    return;
+  }
+
+  // The engine refuses to start while the previous film is being saved
+  if (demonware::client_film_saving() &&
+      GetTickCount64() - last_stop_time < 60000) {
+    return;
+  }
+
+  const auto now = GetTickCount64();
+  if (now < next_auto_attempt) {
+    return;
+  }
+  next_auto_attempt = now + 2000;
+
+  // Only once snapshots are coming in: seen on one attempt, moved on by the
+  // next
+  const int snapshot = get_latest_snapshot_number(0);
+  if (snapshot < 0 || auto_seen_snapshot < 0 ||
+      snapshot == auto_seen_snapshot) {
+    auto_seen_snapshot = snapshot;
+    return;
+  }
+
+  // ...and once the view is our own. Before the first spawn the server shows
+  // us another player; a film that starts there opens on a player slot that
+  // has nothing recorded for us yet.
+  int fetched{};
+  if (!ensure_fake_server() || !fetch_latest_snapshot(0, &fetched)) {
+    return;
+  }
+
+  const int view_client_num =
+      *reinterpret_cast<const int *>(fake.snapshot + SNAP_PS);
+  const int own_client_num = get_own_client_num(0);
+  if (view_client_num != own_client_num) {
+    static int waits_logged{};
+    if (waits_logged++ < 50) {
+      log("auto record: waiting for our own view (showing client %d, we are "
+          "%d)",
+          view_client_num, own_client_num);
+    }
+    next_auto_attempt = now + 500;
+    return;
+  }
+
+  static int attempts_logged{};
+  if (attempts_logged++ < 200) {
+    log("auto record: starting (snapshot %d)", snapshot);
+  }
+
+  if (!start_recording()) {
+    auto_seen_snapshot = -1;
+  }
+}
