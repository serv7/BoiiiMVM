+// --- Asset list of films recorded as a client -------------------------------
+// A film carries the list of every asset (models, vehicles, ...) the server
+// registered at map load; playback rebuilds the client's asset table from it,
+// so entity model numbers in the film line up. Only the server side writes
+// that list, so a film recorded while connected to someone else's server has
+// an empty one. Playback then knows a few hundred models instead of thousands
+// and crashes as soon as a script asks for one it doesn't have (a corpse's
+// body model, a scorestreak vehicle).
+//
+// A client that joins a server never gets such a list either: it registers
+// the same assets itself, in the same order as the server. So for films with
+// an empty list, playback does exactly that instead of reading the list.
+constexpr uintptr_t DEMO_ASSET_LIST_DATA = 0x1593bf558;
+constexpr uintptr_t BG_CACHE_ALLOW_REGISTER = 0x1436841e1;
+
+bool demo_is_playing() {
+  return reinterpret_cast<bool (*)()>(game::relocate(0x142600210))();
+}
+
+// A recorded list starts with a set bit (start of its first section)
+bool film_has_asset_list() {
+  return (*reinterpret_cast<const uint8_t *>(
+              game::relocate(DEMO_ASSET_LIST_DATA)) &
+          1) != 0;
+}
+
+bool cache_init_is_playing_stub() {
+  if (!demo_is_playing()) {
+    return false;
+  }
+
+  if (film_has_asset_list()) {
+    return true;
+  }
+
+  static bool logged{};
+  if (!logged) {
+    logged = true;
+    printf("[ Demo ] Film has no asset list (recorded as a client), "
+           "registering assets like a live client\n");
+  }
+  return false;
+}
