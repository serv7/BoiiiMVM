+// --- clientActive_t pointer -------------------------------------------------
+// The pointer to the client's own state (cl) is stored encrypted and only the
+// protected getter can decode it, and that getter must be called from game
+// code. So a tiny game function that calls it gets a detour right after the
+// call, which keeps a copy of the decoded pointer; calling that function
+// then gives us the pointer.
+WEAK game::symbol<int(int localClientNum)> CL_GetClientActiveField{
+    0x0, 0x141321150, 0x0};
+uint8_t *captured_client_active{};
+
+void install_client_active_capture() {
+  // 0x141321159: mov eax, [rax + 0x10e0f0]; add rsp, 0x28; ret (+ padding)
+  const auto stub = utils::hook::assemble([](utils::hook::assembler &a) {
+    a.get().mov(asmjit::x86::rcx,
+                reinterpret_cast<uint64_t>(&captured_client_active));
+    a.get().mov(asmjit::x86::qword_ptr(asmjit::x86::rcx), asmjit::x86::rax);
+    a.get().mov(asmjit::x86::eax,
+                asmjit::x86::dword_ptr(asmjit::x86::rax, 0x10e0f0));
+    a.get().add(asmjit::x86::rsp, 0x28);
+    a.get().ret();
+  });
+  // "safe" far jump: the plain one goes through rax, which holds the pointer
+  utils::hook::jump(game::relocate(0x141321159), stub, true, true);
+}
+
+const uint8_t *get_client_active(const int local_client_num) {
+  captured_client_active = nullptr;
+  CL_GetClientActiveField(local_client_num);
+  return captured_client_active;
+}
