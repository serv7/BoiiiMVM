+// --- Server commands in the film -------------------------------------------
+// The film starts from the gamestate the server sent when we connected, but
+// recording starts later. Configstrings the server changed in between (sent
+// as "2 <index> <value>" commands) would be missing from the film; playback
+// then has e.g. no vehicle definition for a scorestreak and crashes in script.
+// So remember the latest command per configstring since the gamestate, and
+// play them into the film's first frames before the live commands.
+std::map<int, std::string> configstring_updates; // since the last gamestate
+int tracked_command_sequence{};
+int film_command_client{-1}; // our client number, fixed when recording starts
+
+struct film_command_state {
+  std::vector<char> ring;            // [128][0x400], what the writer reads
+  std::deque<std::string> pending;   // configstring catch-up, oldest first
+  int sequence{};                    // last command number handed to the film
+  int live_sequence{};               // last client command already queued
+};
+film_command_state film_commands;
+
+const char *client_command(const uint8_t *clc, const int sequence) {
+  return reinterpret_cast<const char *>(
+      clc + CLC_SERVER_COMMANDS +
+      static_cast<size_t>(sequence & (MAX_RELIABLE_COMMANDS - 1)) *
+          CLC_SERVER_COMMAND_SIZE);
+}
+
+// Called after every parsed server message while connected to a server
+void track_configstring_commands(const int local_client_num) {
+  const auto *clc = get_client_connection(local_client_num);
+  const int sequence =
+      *reinterpret_cast<const int *>(clc + CLC_SERVER_COMMAND_SEQUENCE);
+  if (sequence < tracked_command_sequence ||
+      sequence - tracked_command_sequence > MAX_RELIABLE_COMMANDS) {
+    tracked_command_sequence = sequence - MAX_RELIABLE_COMMANDS;
+  }
+
+  for (int i = tracked_command_sequence + 1; i <= sequence; ++i) {
+    const char *command = client_command(clc, i);
+    if (command[0] == '2' && command[1] == ' ') {
+      const std::string text(command,
+                             strnlen(command, CLC_SERVER_COMMAND_SIZE - 1));
+      configstring_updates[atoi(command + 2)] = text;
+    }
+  }
+  tracked_command_sequence = sequence;
+}
+
+void begin_film_commands(const int local_client_num, const int client_num) {
+  film_command_client = client_num;
+  const auto *clc = get_client_connection(local_client_num);
+  film_commands.ring.assign(
+      static_cast<size_t>(MAX_RELIABLE_COMMANDS) * CLC_SERVER_COMMAND_SIZE, 0);
+  film_commands.pending.clear();
+  for (const auto &[index, command] : configstring_updates) {
+    film_commands.pending.push_back(command);
+  }
+  film_commands.sequence = 0;
+  film_commands.live_sequence =
+      *reinterpret_cast<const int *>(clc + CLC_SERVER_COMMAND_SEQUENCE);
+  log("film commands: %zu configstring updates to replay",
+      film_commands.pending.size());
+}
+
+// Queues this frame's commands and points the fake server client at them
+void feed_film_commands(const int local_client_num, uint8_t *sv_client) {
+  if (film_commands.ring.empty()) {
+    return;
+  }
+
+  constexpr int MAX_PER_FRAME = 96;
+  int queued = 0;
+  const auto push = [&](const char *command) {
+    ++film_commands.sequence;
+    char *slot = film_commands.ring.data() +
+                 static_cast<size_t>(film_commands.sequence &
+                                     (MAX_RELIABLE_COMMANDS - 1)) *
+                     CLC_SERVER_COMMAND_SIZE;
+    strncpy_s(slot, CLC_SERVER_COMMAND_SIZE, command, _TRUNCATE);
+    ++queued;
+  };
+
+  while (!film_commands.pending.empty() && queued < MAX_PER_FRAME) {
+    push(film_commands.pending.front().data());
+    film_commands.pending.pop_front();
+  }
+
+  // Live commands only once the catch-up is done, so the order is kept
+  if (film_commands.pending.empty()) {
+    const auto *clc = get_client_connection(local_client_num);
+    const int sequence =
+        *reinterpret_cast<const int *>(clc + CLC_SERVER_COMMAND_SEQUENCE);
+    if (sequence - film_commands.live_sequence > MAX_RELIABLE_COMMANDS) {
+      film_commands.live_sequence = sequence - MAX_RELIABLE_COMMANDS;
+    }
+    while (film_commands.live_sequence < sequence && queued < MAX_PER_FRAME) {
+      push(client_command(clc, ++film_commands.live_sequence));
+    }
+  }
+
+  *reinterpret_cast<int *>(sv_client + SV_CLIENT_RELIABLE_SEQUENCE) =
+      film_commands.sequence;
+  for (int i = 0; i < MAX_RELIABLE_COMMANDS; ++i) {
+    *reinterpret_cast<char **>(sv_client + SV_CLIENT_RELIABLE_COMMANDS +
+                               i * 16) =
+        film_commands.ring.data() +
+        static_cast<size_t>(i) * CLC_SERVER_COMMAND_SIZE;
+  }
+}
