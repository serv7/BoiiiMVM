+// --- Theater tile info -------------------------------------------------------
+// The engine builds a film's tile data (map, title, length) from the host's
+// match record, which a client doesn't have, so we work it out ourselves.
+std::optional<std::string> translate(const std::string &reference) {
+  if (reference.empty()) {
+    return {};
+  }
+
+  const char *text = game::seh::SEH_SafeTranslateString(reference.data());
+  if (!text || !*text || text[0] == '^' || reference == text ||
+      std::strstr(text, "UNLOCALIZED")) {
+    return {};
+  }
+  return std::string(text);
+}
+
+// Map table entries as laid out in this game build (checked against the
+// running game: the next entry's name follows 0xF8 bytes on)
+constexpr size_t MAP_ENTRY_SIZE = 0xF8;
+constexpr size_t MAP_ENTRY_NAME = 0x0;          // "mp_biodome"
+constexpr size_t MAP_ENTRY_DISPLAY_NAME = 0x10; // text reference
+constexpr size_t MAP_ENTRY_UNIQUE_ID = 0xF0;
+
+struct map_lookup {
+  std::string name;
+  int unique_id{};
+  std::string display_reference;
+};
+
+void find_map(map_lookup &lookup) {
+  game::db::xasset::DB_EnumXAssets(
+      game::db::xasset::XAssetType::MAPTABLE,
+      [](game::db::xasset::XAssetHeader header, void *data) {
+        auto &wanted = *static_cast<map_lookup *>(data);
+        const auto *table = header.mapTable;
+        if (wanted.unique_id || !table || !table->maps ||
+            table->mapCount > 512) {
+          return;
+        }
+
+        const auto *entries = reinterpret_cast<const uint8_t *>(table->maps);
+        for (uint32_t i = 0; i < table->mapCount; ++i) {
+          const auto *entry = entries + i * MAP_ENTRY_SIZE;
+          const auto *name =
+              *reinterpret_cast<const char *const *>(entry + MAP_ENTRY_NAME);
+          if (!name || _stricmp(name, wanted.name.data()) != 0) {
+            continue;
+          }
+
+          wanted.unique_id =
+              *reinterpret_cast<const int *>(entry + MAP_ENTRY_UNIQUE_ID);
+          const auto *display = *reinterpret_cast<const char *const *>(
+              entry + MAP_ENTRY_DISPLAY_NAME);
+          wanted.display_reference = display ? display : "";
+          return;
+        }
+      },
+      &lookup, false);
+}
