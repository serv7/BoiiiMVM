+std::string gametype_display_name(const std::string &gametype) {
+  static const std::map<std::string, std::string> names = {
+      {"tdm", "Team Deathmatch"},     {"dm", "Free-For-All"},
+      {"dom", "Domination"},          {"koth", "Hardpoint"},
+      {"sd", "Search and Destroy"},   {"ctf", "Capture the Flag"},
+      {"dem", "Demolition"},          {"conf", "Kill Confirmed"},
+      {"ball", "Uplink"},             {"escort", "Safeguard"},
+      {"gun", "Gun Game"},            {"clean", "Fracture"},
+      {"prop", "Prop Hunt"},          {"infect", "Infected"},
+      {"sniperonly", "Snipers Only"}, {"sas", "Sticks and Stones"},
+      {"oic", "One in the Chamber"},  {"shrp", "Sharpshooter"},
+  };
+
+  if (const auto it = names.find(gametype); it != names.end()) {
+    return it->second;
+  }
+
+  std::string reference = "MPUI_" + gametype;
+  for (auto &c : reference) {
+    c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+  }
+  if (auto text = translate(reference)) {
+    return *text;
+  }
+  return gametype;
+}
