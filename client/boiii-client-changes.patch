+// ---- outfit names and pictures ---------------------------------------------
+// The names of each specialist's outfits and a picture of each come from
+// MVM/Theater/outfit-previews (catalog.txt + h<specialist>_<index>.jpg), made
+// from the game's own Personalization screen.
+using Microsoft::WRL::ComPtr;
+const char *const outfit_folder = "MVM/Theater/outfit-previews";
+const char *const outfit_settings_file = "MVM/outfit_menu.cfg";
+
+struct outfit_picture {
+  ComPtr<ID3D11ShaderResourceView> view;
+  uint64_t used{};
+  bool failed{};
+};
+
+std::map<std::string, outfit_picture> outfit_pictures;
+uint64_t outfit_frame{};
+outfits::catalog outfit_names;
+bool outfits_loaded{};
+bool separate_parts{};
+bool editing_head{};
+
+void load_outfit_data() {
+  if (outfits_loaded) {
+    return;
+  }
+  outfits_loaded = true;
+
+  std::ifstream catalog(std::filesystem::path(outfit_folder) / "catalog.txt");
+  outfit_names = outfits::catalog::parse(catalog);
+
+  std::ifstream settings(outfit_settings_file);
+  std::string line;
+  while (std::getline(settings, line)) {
+    if (line.rfind("separate=", 0) == 0) {
+      separate_parts = line.size() > 9 && line[9] == '1';
+    }
+  }
+  diag("outfits: %zu specialists in the catalog",
+       outfit_names.specialists.size());
+}
+
+void save_outfit_settings() {
+  std::ofstream out(outfit_settings_file, std::ios::trunc);
+  out << "separate=" << (separate_parts ? 1 : 0) << "\n";
+}
+
+ComPtr<ID3D11ShaderResourceView> load_outfit_picture(const std::string &name) {
+  auto *device = download_overlay::get_device();
+  if (!device) {
+    return nullptr;
+  }
+
+  const auto path = (std::filesystem::path(outfit_folder) / name).string();
+  int width{}, height{}, channels{};
+  auto *pixels = stbi_load(path.data(), &width, &height, &channels, 4);
+  if (!pixels) {
+    return nullptr;
+  }
+
+  ComPtr<ID3D11ShaderResourceView> view;
+  if (width > 0 && height > 0 && width <= 1024 && height <= 1024) {
+    D3D11_TEXTURE2D_DESC desc{};
+    desc.Width = static_cast<UINT>(width);
+    desc.Height = static_cast<UINT>(height);
+    desc.MipLevels = desc.ArraySize = 1;
+    desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    desc.SampleDesc.Count = 1;
+    desc.Usage = D3D11_USAGE_IMMUTABLE;
+    desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+
+    D3D11_SUBRESOURCE_DATA initial{};
+    initial.pSysMem = pixels;
+    initial.SysMemPitch = static_cast<UINT>(width) * 4;
+
+    ComPtr<ID3D11Texture2D> texture;
+    if (SUCCEEDED(device->CreateTexture2D(&desc, &initial, &texture))) {
+      device->CreateShaderResourceView(texture.Get(), nullptr, &view);
+    }
+  }
+
+  stbi_image_free(pixels);
+  return view;
+}
+
+// Pictures are decoded the first time they are shown and kept, so moving over
+// the list again is instant. Draw commands hold raw pointers until the frame
+// is rendered, so only pictures unused for a few frames are ever dropped.
+ID3D11ShaderResourceView *outfit_picture_for(const std::string &name) {
+  if (outfit_pictures.size() > 160) {
+    for (auto item = outfit_pictures.begin();
+         item != outfit_pictures.end() && outfit_pictures.size() > 120;) {
+      item = item->second.used + 3 < outfit_frame ? outfit_pictures.erase(item)
+                                                  : std::next(item);
+    }
+  }
+
+  auto &item = outfit_pictures[name];
+  item.used = outfit_frame;
+  if (!item.view && !item.failed) {
+    item.view = load_outfit_picture(name);
+    item.failed = !item.view;
+  }
+  return item.view.Get();
+}
+
+void draw_outfit_picture(ID3D11ShaderResourceView *view,
+                         const outfits::rect box, const float v0 = 0.0f) {
+  if (!view) {
+    return;
+  }
+
+  const ImVec2 origin = ImGui::GetCursorScreenPos();
+  ImGui::GetWindowDrawList()->AddImage(
+      ImTextureRef(static_cast<ImTextureID>(reinterpret_cast<uintptr_t>(view))),
+      ImVec2(origin.x + box.x0, origin.y + box.y0),
+      ImVec2(origin.x + box.x1, origin.y + box.y1), ImVec2(0, v0),
+      ImVec2(1, 1));
+}
+
+// A list of names; returns the entry under the mouse, -1 when none
+int outfit_name_list(const char *id, const ImVec2 size,
+                     const outfits::specialist *who, const char *kind,
+                     const int total, const int chosen, int &picked) {
+  int under = -1;
+  if (ImGui::BeginChild(id, size, ImGuiChildFlags_Borders)) {
+    for (int i = 0; i < total; ++i) {
+      const auto label =
+          outfits::label(who, i, kind) + "##" + id + std::to_string(i);
+      if (ImGui::Selectable(label.data(), i == chosen)) {
+        picked = i;
+      }
+      if (ImGui::IsItemHovered()) {
+        under = i;
+      }
+    }
+  }
+  ImGui::EndChild();
+  return under;
+}
+
+void draw_outfits(const specialist_info &entry, const float width,
+                  const float height, const float line) {
+  const auto *who = outfit_names.find(entry.body_type);
+  const int body = get_int("botmod_body");
+  const int head = get_int("botmod_head");
+  const float gap = 8.0f;
+  const float list_width = std::max(140.0f, line * 5.9f);
+  int show_body = body, show_head = head, total = 0;
+
+  if (!separate_parts) {
+    // One entry is the matching body and head. A mixed pair set earlier in
+    // separate mode is left alone until an outfit is picked; it just has no
+    // highlighted entry.
+    total = outfits::outfit_count(who, entry.bodies, entry.heads);
+    int picked = -1;
+    const int under =
+        outfit_name_list("outfits", ImVec2(list_width, height), who, "Outfit",
+                         total, body == head ? body : -1, picked);
+    if (under >= 0) {
+      show_body = show_head = under;
+    }
+    if (picked >= 0) {
+      set_int("botmod_body", picked);
+      set_int("botmod_head", picked);
+    }
+  } else {
+    // One tall list at a time: "Body" and "Head" above it choose which part
+    // it changes
+    const int bodies = outfits::count(who, entry.bodies);
+    const int heads = outfits::count(who, entry.heads);
+    total = bodies + heads;
+    const float half = (list_width - gap) / 2;
+
+    ImGui::BeginGroup();
+    if (ImGui::Selectable("Body##part", !editing_head, 0, ImVec2(half, 0))) {
+      editing_head = false;
+    }
+    ImGui::SameLine();
+    if (ImGui::Selectable("Head##part", editing_head, 0, ImVec2(half, 0))) {
+      editing_head = true;
+    }
+
+    int picked = -1;
+    const ImVec2 size(list_width, std::max(line * 4, height - line - 4));
+    if (!editing_head) {
+      const int under =
+          outfit_name_list("bodies", size, who, "Body", bodies, body, picked);
+      if (under >= 0) {
+        show_body = under;
+      }
+      if (picked >= 0) {
+        set_int("botmod_body", picked);
+      }
+    } else {
+      const int under =
+          outfit_name_list("heads", size, who, "Head", heads, head, picked);
+      if (under >= 0) {
+        show_head = under;
+      }
+      if (picked >= 0) {
+        set_int("botmod_head", picked);
+      }
+    }
+    ImGui::EndGroup();
+  }
+
+  ImGui::SameLine();
+  ImGui::BeginGroup();
+  float picture_width = std::max(110.0f, width - list_width - 2 * gap);
+  float picture_height = picture_width * 399.0f / 360.0f;
+  const float room = height - (show_body == show_head ? 1 : 2) * line;
+  if (picture_height > room && room > 60) {
+    picture_height = room;
+    picture_width = picture_height * 360.0f / 399.0f;
+  }
+
+  if (ImGui::BeginChild("preview", ImVec2(picture_width, picture_height), 0,
+                        ImGuiWindowFlags_NoScrollbar |
+                            ImGuiWindowFlags_NoScrollWithMouse)) {
+    bool drawn = false;
+    if (show_body == show_head) {
+      auto *view = outfit_picture_for(
+          outfits::image_name(entry.body_type, show_body, false));
+      draw_outfit_picture(view, {0, 0, picture_width, picture_height});
+      drawn = view != nullptr;
+    } else {
+      const auto parts = outfits::mix(picture_width, picture_height);
+      auto *top = outfit_picture_for(
+          outfits::image_name(entry.body_type, show_head, true));
+      auto *bottom = outfit_picture_for(
+          outfits::image_name(entry.body_type, show_body, false));
+      draw_outfit_picture(top, parts.head);
+      draw_outfit_picture(bottom, parts.body, parts.body_v0);
+      drawn = top || bottom;
+    }
+    if (!drawn) {
+      ImGui::TextDisabled("%s", total ? "No picture for this one"
+                                      : "Load into a match to list the skins");
+    }
+  }
+  ImGui::EndChild();
+
+  if (show_body == show_head) {
+    ImGui::Text("%s", outfits::label(who, show_body, "Outfit").data());
+  } else {
+    ImGui::Text("Body: %s", outfits::label(who, show_body, "Body").data());
+    ImGui::Text("Head: %s", outfits::label(who, show_head, "Head").data());
+  }
+  ImGui::EndGroup();
+}
