+// ---- game input while the menu is open --------------------------------------
+// The mouse hook stops mouse movement reaching the game while the menu is
+// open, but clicks and keys still got through, so clicking in the menu fired
+// the gun. While it is open in a live match, hand input to the game's menu
+// layer the way the pause menu does, and give it back when the menu closes.
+constexpr uintptr_t LUI_SET_KEY_CATCHER = 0x141f2bdc0; // (localClient, on)
+constexpr uintptr_t KEY_CATCHERS = 0x1453d8bc4;        // uint
+constexpr unsigned KEY_CATCHER_UI = 0x10;
+
+void set_game_menu_input(const bool on) {
+  arxan::detail::set_address_to_call(
+      reinterpret_cast<void *>(game::relocate(LUI_SET_KEY_CATCHER)));
+  static_cast<void (*)(int, bool)>(arxan::detail::callstack_proxy_addr)(0, on);
+}
+
+void sync_game_input() {
+  static bool blocking{};
+  const bool film =
+      reinterpret_cast<bool (*)()>(game::relocate(0x142600210))();
+  const bool open = menu_open && !film;
+
+  if (open && !blocking) {
+    if (*reinterpret_cast<const unsigned *>(game::relocate(KEY_CATCHERS)) &
+        KEY_CATCHER_UI) {
+      return; // a game menu already has the input
+    }
+    set_game_menu_input(true);
+    blocking = true;
+    diag("menu open: game input blocked");
+  } else if (!open && blocking) {
+    blocking = false;
+    if (!film) {
+      set_game_menu_input(false);
+    }
+    diag("menu closed: game input restored");
+  }
 }
 
